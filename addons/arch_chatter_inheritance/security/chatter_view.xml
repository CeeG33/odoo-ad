<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Globally hides William's messages -->
    <record id="filtering_chatter_rule" model="ir.rule">
        <field name="name">Filtering a specific user's messages</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>

        <!-- William's User ID -->
        <field name="domain_force">[
            ("author_id", "!=", 49)
        ]</field>
    </record>

    <!-- Allows William's messages to be seen by the CRM Users group. -->
    <record id="allowing_filtered_message_chatter_rule" model="ir.rule">
        <field name="name">Allowing a specific user's messages</field>
        <field name="model_id" ref="mail.model_mail_message"/>
        <field name="groups" eval="[(4, ref('base.group_no_one'))]"/>  <!-- ref('__import__.crm_users'). -->
        
        <!-- William's User ID -->
        <field name="domain_force">[
            ("author_id", "=", 49)
        ]</field>
    </record>

    
</odoo>
