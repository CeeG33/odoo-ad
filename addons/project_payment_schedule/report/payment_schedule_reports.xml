<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="a4_landscape" model="report.paperformat">
        <field name="name">A4 - Landscape</field>
        <field name="default" eval="True" />
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">33</field>
        <field name="margin_bottom">33</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False" />
        <field name="header_spacing">32</field>
        <field name="dpi">90</field>
    </record>

    <record id="report_payment_schedule_list" model="ir.actions.report">
        <field name="name">Échéancier PDF</field>
        <field name="model">payment.schedule</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_payment_schedule.payment_schedule_list_report</field>
        <field name="report_file">project_payment_schedule.payment_schedule_list_report</field>
        <field name="print_report_name">'Échéancier prévisionnel - %s' % (object.related_order_ids.partner_id.name).replace('/','')</field>
        <field name="binding_model_id" ref="model_payment_schedule"/>
        <field name="binding_type">report</field>
        <field name="binding_view_types">list</field>
        <field name="paperformat_id" ref="project_payment_schedule.a4_landscape"/>
    </record>

</odoo>
